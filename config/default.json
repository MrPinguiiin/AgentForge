{
  "server": {
    "port": 5000,
    "host": "localhost"
  },
  "ai": {
    "defaultProvider": "openai",
    "providers": {
      "openai": {
        "apiKey": "",
        "baseUrl": "https://api.openai.com/v1"
      },
      "anthropic": {
        "apiKey": "",
        "baseUrl": "https://api.anthropic.com"
      },
      "openrouter": {
        "apiKey": "",
        "baseUrl": "https://openrouter.ai/api/v1"
      }
    },
    "agents": {
      "planner": {
        "provider": "openai",
        "model": "gpt-4o-mini",
        "temperature": 0.3,
        "maxTokens": 4096
      },
      "coder": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "reviewer": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.1,
        "maxTokens": 4096
      },
      "frontend": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "backend": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "debugger": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.1,
        "maxTokens": 8192
      },
      "qa": {
        "provider": "openai",
        "model": "gpt-4o-mini",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "docs": {
        "provider": "openai",
        "model": "gpt-4o-mini",
        "temperature": 0.3,
        "maxTokens": 4096
      },
      "explore": {
        "provider": "openai",
        "model": "gpt-4o-mini",
        "temperature": 0.1,
        "maxTokens": 4096
      }
    }
  },
  "context": {
    "maxContextFiles": 20,
    "maxFileSize": 50000,
    "ignorePatterns": [
      "node_modules",
      ".git",
      "dist",
      "build",
      ".next",
      "*.lock",
      "*.min.js",
      "*.map"
    ]
  },
  "git": {
    "autoCommit": true,
    "autoPush": false,
    "commitPrefix": "ai-coder:"
  },
  "router": {
    "maxParallelTasks": 3,
    "autoCreateBranch": true,
    "branchPattern": "agent/{area}-{slug}",
    "requireTestsPass": true,
    "highRiskRequiresHuman": true,
    "pollIntervalMs": 0
  },
  "guardrails": {
    "protectedBranches": ["main", "master", "production", "develop"],
    "maxRetries": 3,
    "requireTestsPass": true,
    "requireLintPass": false,
    "maxFilesPerRun": 20,
    "maxLinesPerRun": 1000,
    "readOnlyAgents": ["explore", "planner"],
    "maxParallelExecutions": 3,
    "agentTimeoutMs": 300000,
    "createBackupBranch": false
  }
}
